<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) to local/dev servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- WiFi / LAN ranges -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.68.0</domain>
        <!-- Mobile Hotspot ranges -->
        <domain includeSubdomains="true">172.20.10.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
    </domain-config>
    <!-- For demo: allow all cleartext traffic (remove in production) -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
